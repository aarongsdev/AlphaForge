# =============================================================================
# AlphaForge — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in all values before starting the app.
# NEVER commit .env to version control.
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME=AlphaForge
APP_ENV=production
# Generate with: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_VERSION=1.0.0
APP_TIMEZONE=UTC
APP_LOCALE=en

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alphaforge_db
DB_USERNAME=alphaforge
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SCHEMA=alphaforge

# Connection pooling
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# External port (for local development access)
DB_EXTERNAL_PORT=5432

# SSL (for production connections to managed databases)
DB_SSLMODE=prefer
# DB_SSLCERT=/path/to/client-cert.pem
# DB_SSLKEY=/path/to/client-key.pem
# DB_SSLROOTCERT=/path/to/server-ca.pem

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_EXTERNAL_PORT=6379

# Redis connection settings
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0
REDIS_RETRY_INTERVAL=100
REDIS_MAX_RETRIES=3

# Cache TTL settings (seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_MARKET_DATA=60
CACHE_TTL_ANALYSIS=300
CACHE_TTL_NEWS=900
CACHE_TTL_USER_PROFILE=1800

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# JWT secret — generate with: php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
JWT_ISSUER=alphaforge
JWT_AUDIENCE=alphaforge-api

# Argon2id password hashing parameters
ARGON2_MEMORY=65536
ARGON2_TIME=4
ARGON2_THREADS=3

# CORS settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-API-Key
CORS_MAX_AGE=86400

# Session settings
SESSION_LIFETIME=120
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Rate limiting
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------------------
# Market Data APIs
# ----------------------------------------------------------------------------

# Alpha Vantage — https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=REPLACE_WITH_ALPHA_VANTAGE_KEY
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Polygon.io — https://polygon.io/
POLYGON_API_KEY=REPLACE_WITH_POLYGON_KEY
POLYGON_BASE_URL=https://api.polygon.io/v2
POLYGON_WEBSOCKET_URL=wss://socket.polygon.io

# News API — https://newsapi.org/
NEWS_API_KEY=REPLACE_WITH_NEWS_API_KEY
NEWS_API_BASE_URL=https://newsapi.org/v2

# Finnhub — https://finnhub.io/
FINNHUB_API_KEY=REPLACE_WITH_FINNHUB_KEY
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_WEBSOCKET_URL=wss://ws.finnhub.io

# OpenAI — https://platform.openai.com/ (used for sentiment analysis)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=30

# ----------------------------------------------------------------------------
# Queue / Worker
# ----------------------------------------------------------------------------
QUEUE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_DEFAULT=default
QUEUE_HIGH_PRIORITY=high
QUEUE_LOW_PRIORITY=low
QUEUE_FAILED_DRIVER=database
QUEUE_RETRY_AFTER=90
QUEUE_BLOCK_FOR=5

# ----------------------------------------------------------------------------
# Mail
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=AlphaForge

# Mailgun (if using Mailgun driver)
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_SECRET=REPLACE_WITH_MAILGUN_SECRET
MAILGUN_ENDPOINT=api.mailgun.net

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS=false
LOG_MAX_FILES=30

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
FILESYSTEM_DRIVER=local
STORAGE_PATH=/var/www/html/storage

# AWS S3 (if using S3 driver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# ----------------------------------------------------------------------------
# Docker Networking
# ----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
FEATURE_CRYPTO=true
FEATURE_OPTIONS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_ML_PREDICTIONS=false
FEATURE_BACKTESTING=true
FEATURE_PAPER_TRADING=true
FEATURE_REAL_TRADING=false

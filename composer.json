{
    "name": "alphaforge/alphaforge",
    "description": "AlphaForge — Professional algorithmic trading signal and portfolio analysis platform",
    "type": "project",
    "license": "proprietary",
    "version": "1.0.0",
    "keywords": [
        "trading",
        "finance",
        "algorithmic",
        "signals",
        "portfolio",
        "analysis"
    ],
    "authors": [
        {
            "name": "AlphaForge Team",
            "email": "dev@alphaforge.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "ext-zip": "*",
        "ext-bcmath": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "predis/predis": "^2.3",
        "monolog/monolog": "^3.7",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/cache": "^7.1",
        "symfony/console": "^7.1",
        "symfony/event-dispatcher": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/validator": "^7.1",
        "ramsey/uuid": "^4.7",
        "brick/math": "^0.12",
        "nesbot/carbon": "^3.7",
        "league/container": "^4.2",
        "league/fractal": "^0.20",
        "psr/log": "^3.0",
        "psr/cache": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "brianium/paratest": "^7.4",
        "phpstan/extension-installer": "^1.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "AlphaForge\\": "src/",
            "AlphaForge\\Database\\Migrations\\": "database/migrations/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AlphaForge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --coverage-html coverage/ --colors=always",
        "test:parallel": "paratest --colors",
        "lint": "phpcs --standard=PSR12 src/ tests/",
        "lint:fix": "phpcbf --standard=PSR12 src/ tests/",
        "analyse": "phpstan analyse src/ --level=8",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
